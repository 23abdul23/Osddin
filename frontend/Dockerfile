### STAGE 1: Build ###
FROM node:22.15-alpine AS builder

WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

COPY . .

RUN pnpm run build

### STAGE 2: Serve ###
FROM nginx:1.29-alpine

RUN apk add --no-cache apache2-utils

RUN rm /etc/nginx/conf.d/default.conf
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

COPY nginx/30-setup-basic-auth.sh /docker-entrypoint.d/30-setup-basic-auth.sh
RUN chmod +x /docker-entrypoint.d/30-setup-basic-auth.sh

RUN touch /etc/nginx/conf.d/basic-auth.conf

# Copy everything generated by Next export
COPY --from=builder /app/out/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]